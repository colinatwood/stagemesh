{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/lighting-endpoint-profile-v1.json",
  "title": "UPP Lighting Endpoint Profile v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "protocol", "timing"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96},
    "protocol": {"enum": ["artnet", "sacn", "dmx", "adapter"]},
    "target": {"type": "string", "maxLength": 160},
    "universes": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 63999},
      "uniqueItems": true
    },
    "universeBase": {"type": "integer", "minimum": 1, "maximum": 63984},
    "timing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fixedLatencyNs": {"type": "integer", "minimum": 0},
        "jitterNs": {"type": "integer", "minimum": 0},
        "minimumLookaheadNs": {"type": "integer", "minimum": 0},
        "timestampedExecution": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": {"type": "string"},
        "leaseRequired": {"type": "boolean"}
      }
    }
  }
}
