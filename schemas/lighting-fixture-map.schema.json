{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/lighting-fixture-map-v1.json",
  "title": "UPP Venue Lighting Fixture Map v1",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": true,
    "required": ["universe", "address", "parameters"],
    "properties": {
      "universe": {"type": "integer", "minimum": 0, "maximum": 15},
      "address": {"type": "integer", "minimum": 1, "maximum": 512},
      "parameters": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 511},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "offset": {"type": "integer", "minimum": 0, "maximum": 511},
                "minimum": {"type": "integer", "minimum": 0, "maximum": 255},
                "maximum": {"type": "integer", "minimum": 0, "maximum": 255},
                "invert": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  }
}
