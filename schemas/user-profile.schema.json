{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/user-profile-v1.json",
  "title": "UPP user customization profile",
  "type": "object",
  "required": ["documentType", "schemaVersion", "minimumReaderSchemaVersion", "profileId", "revision", "preferences", "unknownFieldsPreserved"],
  "properties": {
    "documentType": {"const": "org.upp.user-profile"},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "minimumReaderSchemaVersion": {"type": "integer", "minimum": 1},
    "profileId": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0},
    "display": {"type": "object", "additionalProperties": true},
    "accessibility": {"type": "object", "additionalProperties": true},
    "workflow": {"type": "object", "additionalProperties": true},
    "controlLayout": {"type": "object", "additionalProperties": true},
    "preferences": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["namespace", "key", "layer", "revision", "type", "value"],
        "properties": {
          "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
          "key": {"type": "string", "minLength": 1, "maxLength": 128},
          "layer": {"enum": ["base", "user", "role", "venue", "session"]},
          "revision": {"type": "integer", "minimum": 1},
          "type": {"enum": ["boolean", "integer", "scalar", "token"]},
          "value": {}
        },
        "additionalProperties": true
      }
    },
    "extensions": {"type": "object", "additionalProperties": true},
    "unknownFieldsPreserved": {"const": true}
  },
  "additionalProperties": true
}
