{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/show-dispatch-status-v1.json",
  "title": "UPP Show Dispatch Status v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["submitted", "accepted", "dispatched", "pending", "duplicates", "late"],
  "properties": {
    "submitted": {"type": "integer", "minimum": 0},
    "accepted": {"type": "integer", "minimum": 0},
    "dispatched": {"type": "integer", "minimum": 0},
    "pending": {"type": "integer", "minimum": 0},
    "nextShowTimeNs": {"type": "integer", "minimum": 0},
    "duplicates": {"type": "integer", "minimum": 0},
    "invalid": {"type": "integer", "minimum": 0},
    "ingressOverflow": {"type": "integer", "minimum": 0},
    "timelineOverflow": {"type": "integer", "minimum": 0},
    "late": {"type": "integer", "minimum": 0},
    "droppedLate": {"type": "integer", "minimum": 0},
    "dispatchFailures": {"type": "integer", "minimum": 0},
    "cancelled": {"type": "integer", "minimum": 0}
  }
}
