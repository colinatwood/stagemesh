{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/independent-witness-topology-v1.json",
  "title": "UPP Independent Witness Topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "quorum", "maxClockSkewMs", "allowInsecureLoopback", "witnesses"],
  "properties": {
    "version": {"const": 1},
    "quorum": {"type": "integer", "minimum": 1, "maximum": 9},
    "maxClockSkewMs": {"type": "integer", "minimum": 50, "maximum": 10000},
    "allowInsecureLoopback": {"type": "boolean"},
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "witnessId", "failureDomain", "keyringFile"],
        "properties": {
          "url": {"type": "string", "pattern": "^https?://[^/?#]+/?$"},
          "witnessId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
          "failureDomain": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
          "keyringFile": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
