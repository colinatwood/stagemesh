{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/venue-realization-evidence-v1.json",
  "title": "UPP Venue Realization Evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["patchKey", "healthy"],
  "properties": {
    "patchKey": {"type": "string", "minLength": 1},
    "providerId": {"type": ["string", "null"]},
    "providerType": {"type": ["string", "null"]},
    "target": {"type": ["string", "null"]},
    "healthy": {"type": "boolean"},
    "authorityHolder": {"type": ["string", "null"]},
    "executionState": {"type": "string"},
    "reportedAt": {"type": "string"}
  }
}
