{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://upp.stagemesh.dev/schema/session-channel-frame-v1.json","title":"UPP authenticated session channel frame","type":"object","required":["sessionId","keyEpoch","sequence","capabilityId","payloadSize","authenticated","confidential","physicalOutputsArmed"],"properties":{"sessionId":{"type":"string","pattern":"^[0-9a-f]{32}$"},"keyEpoch":{"type":"integer","minimum":1},"sequence":{"type":"integer","minimum":1},"capabilityId":{"type":"integer","minimum":1},"payloadSize":{"type":"integer","minimum":0,"maximum":4096},"authenticated":{"const":true},"confidential":{"const":false},"physicalOutputsArmed":{"const":false}},"additionalProperties":false}
