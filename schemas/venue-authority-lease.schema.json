{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/venue-authority-lease-v1.json",
  "title": "UPP Venue Authority Lease v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "leaseId",
    "scopeKind",
    "scope",
    "context",
    "grantee",
    "issuedAt",
    "ttlSeconds",
    "active"
  ],
  "properties": {
    "leaseId": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "grantee": {
      "type": "string",
      "minLength": 1
    },
    "grantedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuedAt": {
      "type": "string"
    },
    "ttlSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 43200
    },
    "active": {
      "type": "boolean"
    },
    "remainingSeconds": {
      "type": "number",
      "minimum": 0
    },
    "revoked": {
      "type": "boolean"
    },
    "scopeKind": {
      "type": "string",
      "enum": [
        "patch",
        "department",
        "resource"
      ]
    },
    "context": {
      "type": "string",
      "enum": [
        "venue",
        "runtime"
      ]
    },
    "publicRecord": {
      "$ref": "public-record-reference.schema.json"
    }
  }
}
