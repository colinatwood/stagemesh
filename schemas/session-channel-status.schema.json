{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://upp.stagemesh.dev/schema/session-channel-status-v1.json","title":"UPP authenticated session channel status","type":"object","required":["sessionId","keyEpoch","outboundSequence","inboundSequence","accepted","rejected","capabilityCount","authenticated","confidential","physicalOutputsArmed"],"properties":{"sessionId":{"type":"string","pattern":"^[0-9a-f]{32}$"},"keyEpoch":{"type":"integer","minimum":1},"previousKeyEpoch":{"type":"integer","minimum":0},"outboundSequence":{"type":"integer","minimum":0},"inboundSequence":{"type":"integer","minimum":0},"accepted":{"type":"integer","minimum":0},"rejected":{"type":"integer","minimum":0},"capabilityCount":{"type":"integer","minimum":1,"maximum":64},"authenticated":{"const":true},"confidential":{"const":false},"physicalOutputsArmed":{"const":false}},"additionalProperties":false}
