{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.stagemesh.dev/schema/adapter-manifest-v1.json",
  "title": "UPP Adapter Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "kind", "priority", "capabilities", "fallbacks"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{1,127}$"},
    "name": {"type": "string"},
    "kind": {"type": "string"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 5},
    "estimatedCpu": {"type": "number", "minimum": 0},
    "estimatedMemoryMb": {"type": "integer", "minimum": 0},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fallbacks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "realtime": {"type": "boolean"}
  }
}
