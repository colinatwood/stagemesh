{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StageMesh",
  "version": "0.1.0",
  "identifier": "org.stagemesh.desktop",
  "build": {
    "frontendDist": "../../frontend",
    "beforeBuildCommand": "npm run tauri icon src-tauri/icons/stagemesh.svg"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/stagemesh-runtime",
      "binaries/stagemesh_engine"
    ],
    "resources": {
      "../../frontend": "frontend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
