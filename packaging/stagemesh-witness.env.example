# One file per independently deployed witness host. Do not reuse a witnessId,
# failureDomain or HMAC keyring on another witness.
STAGEFORGE_WITNESS_ID=witness-a
STAGEFORGE_WITNESS_FAILURE_DOMAIN=venue-ups-a
STAGEFORGE_WITNESS_KEYRING_FILE=/etc/stageforge/witness-a-keys.json
STAGEFORGE_WITNESS_PORT=8790

# The witness server is deliberately loopback-only here. Terminate TLS at the
# witness host and expose only that HTTPS endpoint to StageForge nodes.
# Do not set STAGEFORGE_WITNESS_SECRET or STAGEFORGE_REPLICATION_SECRET in
# strict independent-witness mode.
