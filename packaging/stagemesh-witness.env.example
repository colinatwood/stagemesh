# One file per independently deployed witness host. Do not reuse a witnessId,
# failureDomain or HMAC keyring on another witness.
STAGEMESH_WITNESS_ID=witness-a
STAGEMESH_WITNESS_FAILURE_DOMAIN=venue-ups-a
STAGEMESH_WITNESS_KEYRING_FILE=/etc/stagemesh/witness-a-keys.json
STAGEMESH_WITNESS_PORT=8790

# The witness server is deliberately loopback-only here. Terminate TLS at the
# witness host and expose only that HTTPS endpoint to StageMesh nodes.
# Do not set STAGEMESH_WITNESS_SECRET or STAGEMESH_REPLICATION_SECRET in
# strict independent-witness mode.
