[Unit]
Description=StageMesh UPP Core
After=local-fs.target sound.target bluetooth.target

[Service]
Type=simple
User=stagemesh
Group=stagemesh
RuntimeDirectory=stagemesh
StateDirectory=stagemesh
Environment=STAGEMESH_DATA_DIR=/var/lib/stagemesh
Environment=STAGEMESH_NATIVE_ENGINE=/usr/libexec/stagemesh/stagemesh_engine
EnvironmentFile=-/etc/stagemesh/stagemesh.env
ExecStart=/usr/bin/python3 /usr/share/stagemesh/backend/dev_server.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=false
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/stagemesh /run/stagemesh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
