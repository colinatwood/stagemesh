[Unit]
Description=StageMesh Independent Witness
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stagemesh
Group=stagemesh
StateDirectory=stagemesh
RuntimeDirectory=stagemesh
Environment=STAGEMESH_WITNESS_INDEPENDENT=1
Environment=STAGEMESH_WITNESS_HOST=127.0.0.1
Environment=STAGEMESH_WITNESS_DATA=/var/lib/stagemesh/witness/leases.json
EnvironmentFile=-/etc/stagemesh/witness.env
ExecStart=/usr/bin/python3 /usr/share/stagemesh/backend/witness_server.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/stagemesh /run/stagemesh
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
