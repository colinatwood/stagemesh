# Non-secret StageMesh systemd environment example for a reviewed TLS/auth proxy.
# Keep the bridge on loopback. Secrets live in the private credential file, not here.
STAGEMESH_DEPLOYMENT_PROFILE=proxy-https
STAGEMESH_REQUIRE_API_TOKEN=1
STAGEMESH_ALLOWED_HOSTS=stage-console.internal
STAGEMESH_ALLOWED_ORIGINS=https://stage-console.internal
STAGEMESH_HTTP_CREDENTIAL_FILE=/etc/stagemesh/http-credentials.json
STAGEMESH_HTTP_AUTHORIZATION_FILE=/etc/stagemesh/http-authorization.json
