# Non-secret StageForge systemd environment example for a reviewed TLS/auth proxy.
# Keep the bridge on loopback. Secrets live in the private credential file, not here.
STAGEFORGE_DEPLOYMENT_PROFILE=proxy-https
STAGEFORGE_REQUIRE_API_TOKEN=1
STAGEFORGE_ALLOWED_HOSTS=stage-console.internal
STAGEFORGE_ALLOWED_ORIGINS=https://stage-console.internal
STAGEFORGE_HTTP_CREDENTIAL_FILE=/etc/stageforge/http-credentials.json
STAGEFORGE_HTTP_AUTHORIZATION_FILE=/etc/stageforge/http-authorization.json
